# Quantum Portfolio Optimizer — Environment Configuration
# =========================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
#
# The app works without any of these set — it will run QAOA on the
# local Aer simulator and serve on port 8501.

# ---------------------------------------------------------------------------
# IBM Quantum credentials (optional)
# Get your token at: https://quantum.ibm.com/  →  Account  →  API token
# ---------------------------------------------------------------------------
IBM_QUANTUM_TOKEN=
# Leave IBM_QUANTUM_BACKEND empty to auto-select the least-busy device,
# or set a specific backend name, e.g.:  IBM_QUANTUM_BACKEND=ibm_sherbrooke
IBM_QUANTUM_BACKEND=

# ---------------------------------------------------------------------------
# Streamlit server settings (for production / Docker deployment)
# These can also be set in .streamlit/config.toml
# ---------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
