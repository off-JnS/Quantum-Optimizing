# Quantum Portfolio Optimizer — Environment Configuration
# =========================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
#
# The app works without any of these set — it will run QAOA on the
# local Aer simulator and serve on port 8501.

# ---------------------------------------------------------------------------
# IBM Quantum credentials (optional) — full walkthrough in docs/IBM_SETUP.md
# Create an API key at: https://quantum.cloud.ibm.com  (Home dashboard)
# ---------------------------------------------------------------------------
# Your 44-character API key (shown only once when created):
IBM_QUANTUM_TOKEN=
# Your instance's Cloud Resource Name, copied from the Instances page.
# Recommended — required if your account has more than one instance:
IBM_QUANTUM_INSTANCE=
# Leave IBM_QUANTUM_BACKEND empty to auto-select the least-busy device,
# or set a specific backend name, e.g.:  IBM_QUANTUM_BACKEND=ibm_torino
IBM_QUANTUM_BACKEND=

# ---------------------------------------------------------------------------
# Docker deployment only (docker-compose.yml)
# Set DOMAIN to your domain for automatic HTTPS via Caddy/Let's Encrypt;
# leave empty to serve plain HTTP on the server's IP (port 80).
# ---------------------------------------------------------------------------
DOMAIN=

# ---------------------------------------------------------------------------
# Streamlit server settings (for production / Docker deployment)
# These can also be set in .streamlit/config.toml
# ---------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
